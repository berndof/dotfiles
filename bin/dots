#!/usr/bin/env bash
# =============================================================================
# dots — Explicit Dotfiles & Terminal Environment Manager
# Repository: https://github.com/berndof/dotfiles
# =============================================================================
set -euo pipefail

# Resolve repository root even when invoked via symlink (~/.local/bin/dots)
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
SOURCE_PATH="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)/$(basename "$SOURCE")"
MANIFEST="$REPO_ROOT/configs/manifest.tsv"
PROFILES_FILE="$REPO_ROOT/configs/profiles.tsv"
BACKUP_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles-backups"
DOTS_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/dots"
DOTS_CONFIG_FILE="$DOTS_CONFIG_DIR/config"
DOTS_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/dots"
UPDATE_CACHE_FILE="$DOTS_CACHE_DIR/update-check.env"
CLI_PROFILE_OVERRIDE="${DOTS_PROFILE:-}"

# Colors
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  C_RESET=$'\033[0m'
  C_BOLD=$'\033[1m'
  C_DIM=$'\033[2m'
  C_GREEN=$'\033[38;5;114m'
  C_YELLOW=$'\033[38;5;215m'
  C_RED=$'\033[38;5;204m'
  C_BLUE=$'\033[38;5;111m'
  C_CYAN=$'\033[38;5;117m'
  C_MAUVE=$'\033[38;5;183m'
else
  C_RESET="" C_BOLD="" C_DIM="" C_GREEN="" C_YELLOW="" C_RED="" C_BLUE="" C_CYAN="" C_MAUVE=""
fi

log_info()  { printf "%s[INFO]%s  %s\n" "$C_BLUE" "$C_RESET" "$*"; }
log_ok()    { printf "%s[OK]%s    %s\n" "$C_GREEN" "$C_RESET" "$*"; }
log_warn()  { printf "%s[WARN]%s  %s\n" "$C_YELLOW" "$C_RESET" "$*"; }
log_err()   { printf "%s[ERR]%s   %s\n" "$C_RED" "$C_RESET" "$*" >&2; }

usage() {
  cat <<EOF
${C_BOLD}${C_MAUVE}dots${C_RESET} — Terminal Environment & Dotfiles Manager (${C_DIM}${REPO_ROOT}${C_RESET})

${C_BOLD}USAGE:${C_RESET}
  dots [--profile <name>] <command> [options]

${C_BOLD}COMMANDS:${C_RESET}
  ${C_CYAN}status${C_RESET}       [component|all]                  Compare live system (~/) vs repository configs (default: profile)
  ${C_CYAN}diff${C_RESET}         [component|all]                  Show unified diff between repo and live files (default: profile)
  ${C_CYAN}collect${C_RESET}      [component|all] [-c "msg"] [-p]  Capture live configs from ~/ into repository
  ${C_CYAN}apply${C_RESET}        [component|all] [--dry-run]      Apply repository configs to ~/ (with auto-backup)
  ${C_CYAN}profile${C_RESET}      [select|list|get|set <name>|auto] Inspect or switch machine profile (~/.config/dots/config)
  ${C_CYAN}check-update${C_RESET} [--cached|--enable|--disable]     Check upstream repository updates & manage auto-check
  ${C_CYAN}theme${C_RESET}        [list|konsole|prompt]            Inspect or switch Konsole colorscheme / Zsh prompt
  ${C_CYAN}doctor${C_RESET}                                        Verify CLI tools, fonts, Zinit plugins & hygiene
  ${C_CYAN}bench${C_RESET}        [runs]                           Benchmark interactive Zsh startup latency (ms)
  ${C_CYAN}backup${C_RESET}       [list|restore <id>]              List or restore automatic pre-apply backups
  ${C_CYAN}update${C_RESET}       [--check] [--dry-run]            Pull latest from origin and apply profile configs (remote-safe)

${C_BOLD}PROFILES:${C_RESET}
  desktop, wsl, server, minimal (persisted in ~/.config/dots/config; override with --profile or DOTS_PROFILE)

${C_BOLD}COMPONENTS:${C_RESET}
  profile (default), all, zsh, p10k, git, konsole, prompts, atuin, micro, btop, fastfetch

${C_BOLD}EXAMPLES:${C_RESET}
  dots status
  dots status all
  dots profile
  dots profile set server --apply
  dots check-update
  dots update --check
  dots diff zsh
  dots collect -c "feat(zsh): add new alias" -p
  dots apply konsole
  dots theme konsole TokyoNight
  dots theme prompt starship
  dots doctor
EOF
}

# -----------------------------------------------------------------------------
# Helpers: Local Config, Cache, Profiles, Manifest & Secret Scanner
# -----------------------------------------------------------------------------
read_kv_file_key() {
  local file="$1"
  local key="$2"
  local default="${3:-}"
  if [[ ! -f "$file" ]]; then
    printf '%s\n' "$default"
    return 0
  fi
  local line val=""
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
    if [[ "$line" == "${key}="* ]]; then
      val="${line#*=}"
    fi
  done < "$file"
  if [[ -n "$val" ]]; then
    printf '%s\n' "$val"
  else
    printf '%s\n' "$default"
  fi
}

write_local_config_key() {
  local key="$1"
  local value="$2"
  mkdir -p "$DOTS_CONFIG_DIR"
  chmod 700 "$DOTS_CONFIG_DIR" 2>/dev/null || true

  local tmp_file
  tmp_file="$(mktemp "$DOTS_CONFIG_DIR/config.XXXXXX")"
  local found=0

  if [[ -f "$DOTS_CONFIG_FILE" ]]; then
    local line
    while IFS= read -r line || [[ -n "$line" ]]; do
      if [[ "$line" == "${key}="* ]]; then
        if (( found == 0 )); then
          printf '%s=%s\n' "$key" "$value" >> "$tmp_file"
          found=1
        fi
      else
        printf '%s\n' "$line" >> "$tmp_file"
      fi
    done < "$DOTS_CONFIG_FILE"
  else
    printf '# dots local machine configuration (untracked)\n' >> "$tmp_file"
  fi

  if (( found == 0 )); then
    printf '%s=%s\n' "$key" "$value" >> "$tmp_file"
  fi

  mv "$tmp_file" "$DOTS_CONFIG_FILE"
}

normalize_profile_name() {
  local name="${1:-}"
  case "$name" in
    ssh|headless|remote) printf 'server\n' ;;
    *) printf '%s\n' "$name" ;;
  esac
}

is_valid_profile() {
  local norm
  norm="$(normalize_profile_name "${1:-}")"
  [[ -n "$norm" && -f "$PROFILES_FILE" ]] || return 1
  local p _rest
  while IFS=$'\t' read -r p _rest; do
    [[ -z "$p" || "$p" =~ ^# ]] && continue
    [[ "$p" == "$norm" ]] && return 0
  done < "$PROFILES_FILE"
  return 1
}

validate_cli_profile_override() {
  if [[ -n "$CLI_PROFILE_OVERRIDE" ]]; then
    local norm
    norm="$(normalize_profile_name "$CLI_PROFILE_OVERRIDE")"
    if ! is_valid_profile "$norm"; then
      log_err "Unknown profile '$CLI_PROFILE_OVERRIDE'. Valid profiles: desktop, wsl, server, minimal"
      exit 1
    fi
  fi
}

detect_suggested_profile() {
  if [[ -n "${WSL_DISTRO_NAME:-}" || -f /proc/sys/fs/binfmt_misc/WSLInterop ]] || grep -qi microsoft /proc/version 2>/dev/null; then
    printf 'wsl\n'
  elif [[ -n "${SSH_CONNECTION:-}" || -n "${SSH_CLIENT:-}" || -n "${SSH_TTY:-}" ]]; then
    printf 'server\n'
  elif [[ -z "${DISPLAY:-}" && -z "${WAYLAND_DISPLAY:-}" ]]; then
    printf 'server\n'
  else
    printf 'desktop\n'
  fi
}

get_active_profile() {
  if [[ -n "$CLI_PROFILE_OVERRIDE" ]]; then
    local norm
    norm="$(normalize_profile_name "$CLI_PROFILE_OVERRIDE")"
    if ! is_valid_profile "$norm"; then
      log_err "Unknown profile '$CLI_PROFILE_OVERRIDE'. Valid profiles: desktop, wsl, server, minimal"
      exit 1
    fi
    printf '%s\n' "$norm"
    return 0
  fi

  local saved
  saved="$(read_kv_file_key "$DOTS_CONFIG_FILE" "PROFILE" "")"
  if [[ -n "$saved" ]] && is_valid_profile "$saved"; then
    normalize_profile_name "$saved"
    return 0
  fi

  detect_suggested_profile
}

get_profile_source() {
  if [[ -n "$CLI_PROFILE_OVERRIDE" ]]; then
    printf 'override\n'
    return 0
  fi
  local saved
  saved="$(read_kv_file_key "$DOTS_CONFIG_FILE" "PROFILE" "")"
  if [[ -n "$saved" ]] && is_valid_profile "$saved"; then
    printf 'saved\n'
  else
    printf 'auto-detected\n'
  fi
}

get_profile_field() {
  local target_profile
  target_profile="$(normalize_profile_name "$1")"
  local col_index="$2"
  [[ -f "$PROFILES_FILE" ]] || return 1

  local p comps flags fonts desc
  while IFS=$'\t' read -r p comps flags fonts desc; do
    [[ -z "$p" || "$p" =~ ^# ]] && continue
    if [[ "$p" == "$target_profile" ]]; then
      case "$col_index" in
        1) printf '%s\n' "$p" ;;
        2) printf '%s\n' "$comps" ;;
        3) printf '%s\n' "$flags" ;;
        4) printf '%s\n' "$fonts" ;;
        5) printf '%s\n' "$desc" ;;
      esac
      return 0
    fi
  done < "$PROFILES_FILE"
  return 1
}

profile_has_component() {
  local profile="$1"
  local comp="$2"
  local comps
  comps="$(get_profile_field "$profile" 2 || true)"
  [[ -n "$comps" ]] && [[ ",${comps}," == *",${comp},"* ]]
}

matches_filter() {
  local comp="$1"
  local filter="${2:-profile}"
  if [[ "$filter" == "all" ]]; then
    return 0
  elif [[ "$filter" == "profile" ]]; then
    profile_has_component "$(get_active_profile)" "$comp"
  else
    [[ "$filter" == "$comp" ]]
  fi
}

format_filter_label() {
  local filter="$1"
  if [[ "$filter" == "profile" ]]; then
    printf 'profile: %s' "$(get_active_profile)"
  else
    printf '%s' "$filter"
  fi
}

get_git_upstream() {
  local upstream=""
  upstream="$(git -C "$REPO_ROOT" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
  if [[ -z "$upstream" ]] && git -C "$REPO_ROOT" rev-parse --verify --quiet origin/main >/dev/null 2>&1; then
    upstream="origin/main"
  elif [[ -z "$upstream" ]] && git -C "$REPO_ROOT" rev-parse --verify --quiet origin/master >/dev/null 2>&1; then
    upstream="origin/master"
  fi
  printf '%s\n' "$upstream"
}

write_update_cache() {
  local last_epoch="$1"
  local behind="$2"
  local ahead="$3"
  local local_head="$4"
  local remote_head="$5"
  local upstream="$6"
  local subject="$7"

  mkdir -p "$DOTS_CACHE_DIR"
  local tmp_file
  tmp_file="$(mktemp "$DOTS_CACHE_DIR/update-check.XXXXXX")"
  cat > "$tmp_file" <<EOF
LAST_CHECK_EPOCH=${last_epoch}
REMOTE_BEHIND=${behind}
REMOTE_AHEAD=${ahead}
LOCAL_HEAD=${local_head}
REMOTE_HEAD=${remote_head}
UPSTREAM=${upstream}
REPO_ROOT=${REPO_ROOT}
LATEST_SUBJECT=${subject}
EOF
  mv "$tmp_file" "$UPDATE_CACHE_FILE"
}

refresh_update_cache_from_git() {
  local last_epoch="${1:-}"
  if [[ -z "$last_epoch" ]]; then
    last_epoch="$(read_kv_file_key "$UPDATE_CACHE_FILE" "LAST_CHECK_EPOCH" "0")"
  fi
  [[ -d "$REPO_ROOT/.git" ]] || return 0

  local upstream local_head remote_head="" ahead=0 behind=0 subject=""
  upstream="$(get_git_upstream)"
  local_head="$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null || echo "")"

  if [[ -n "$upstream" ]] && git -C "$REPO_ROOT" rev-parse --verify --quiet "$upstream" >/dev/null 2>&1; then
    remote_head="$(git -C "$REPO_ROOT" rev-parse "$upstream" 2>/dev/null || echo "")"
    local counts
    counts="$(git -C "$REPO_ROOT" rev-list --left-right --count "HEAD...${upstream}" 2>/dev/null || echo "0 0")"
    read -r ahead behind <<< "$counts"
    ahead="${ahead:-0}"
    behind="${behind:-0}"
    if (( behind > 0 )); then
      subject="$(git -C "$REPO_ROOT" log -1 --format='%s' "$upstream" 2>/dev/null | tr -d '\n\r$`' | cut -c1-72 || true)"
    fi
  fi

  write_update_cache "$last_epoch" "$behind" "$ahead" "$local_head" "$remote_head" "${upstream:-none}" "$subject"
}

format_epoch_age() {
  local epoch="${1:-0}"
  if [[ -z "$epoch" || ! "$epoch" =~ ^[0-9]+$ || "$epoch" -le 0 ]]; then
    printf 'never\n'
    return 0
  fi
  local now delta
  now="$(date +%s)"
  delta=$(( now - epoch ))
  if (( delta < 0 )); then
    printf 'backoff\n'
  elif (( delta < 60 )); then
    printf 'just now\n'
  elif (( delta < 3600 )); then
    printf '%dm ago\n' "$(( delta / 60 ))"
  elif (( delta < 86400 )); then
    printf '%dh ago\n' "$(( delta / 3600 ))"
  else
    printf '%dd ago\n' "$(( delta / 86400 ))"
  fi
}

run_git_fetch() {
  local remote="${1:-origin}"
  local git_ssh="${GIT_SSH_COMMAND:-ssh -o BatchMode=yes -o ConnectTimeout=5}"
  local cmd=(git -C "$REPO_ROOT" fetch --quiet "$remote")
  if command -v timeout >/dev/null 2>&1; then
    GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="$git_ssh" timeout 8 "${cmd[@]}" </dev/null >/dev/null 2>&1
  else
    GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="$git_ssh" "${cmd[@]}" </dev/null >/dev/null 2>&1
  fi
}

scan_secrets() {
  local bad=0
  local pattern='(ghp_[A-Za-z0-9]{20,}|gho_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk-[A-Za-z0-9]{20,}|AIza[0-9A-Za-z_-]{35}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----)'
  while IFS= read -r -d '' file; do
    if grep -qE "$pattern" "$file" 2>/dev/null; then
      log_err "Potential secret/token detected in: ${file#"$REPO_ROOT/"}"
      grep -nE "$pattern" "$file" >&2 || true
      bad=1
    fi
  done < <(find "$REPO_ROOT/configs" -type f -print0 2>/dev/null)
  return "$bad"
}

get_active_konsole_scheme() {
  local profile="$HOME/.local/share/konsole/zsh.profile"
  if [[ -f "$profile" ]]; then
    grep -E '^ColorScheme=' "$profile" | head -n1 | cut -d= -f2- || echo "unknown"
  else
    echo "not-installed"
  fi
}

get_active_prompt_engine() {
  local zshrc="$HOME/.zshrc"
  if [[ ! -f "$zshrc" ]]; then
    echo "not-installed"
  elif grep -qE '^\s*eval "\$\(starship init zsh\)"' "$zshrc"; then
    echo "starship"
  elif grep -qE 'powerlevel10k|p10k\.zsh' "$zshrc"; then
    echo "powerlevel10k"
  else
    echo "custom"
  fi
}

# -----------------------------------------------------------------------------
# Command: status
# -----------------------------------------------------------------------------
cmd_status() {
  local filter="profile"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --profile)
        CLI_PROFILE_OVERRIDE="${2:-}"
        validate_cli_profile_override
        shift 2
        ;;
      --profile=*)
        CLI_PROFILE_OVERRIDE="${1#*=}"
        validate_cli_profile_override
        shift
        ;;
      *)
        filter="$1"
        shift
        ;;
    esac
  done

  local in_sync=0 drifted=0 missing=0
  local active_profile profile_source
  active_profile="$(get_active_profile)"
  profile_source="$(get_profile_source)"

  printf "\n${C_BOLD}${C_MAUVE}╭─ Terminal Environment Status${C_RESET} (${C_DIM}%s${C_RESET})\n" "$REPO_ROOT"
  printf "${C_BOLD}${C_MAUVE}│${C_RESET}  Machine Profile : ${C_CYAN}%s${C_RESET} ${C_DIM}(%s)${C_RESET}\n" "$active_profile" "$profile_source"
  if matches_filter "konsole" "$filter"; then
    printf "${C_BOLD}${C_MAUVE}│${C_RESET}  Konsole Theme   : ${C_CYAN}%s${C_RESET}\n" "$(get_active_konsole_scheme)"
  fi
  printf "${C_BOLD}${C_MAUVE}│${C_RESET}  Prompt Engine   : ${C_CYAN}%s${C_RESET}\n" "$(get_active_prompt_engine)"
  printf "${C_BOLD}${C_MAUVE}╰──────────────────────────────────────────────────────────────────────────${C_RESET}\n\n"

  printf "  ${C_BOLD}%-10s %-34s %-22s %s${C_RESET}\n" "COMPONENT" "TARGET (~)" "STATUS" "DESCRIPTION"
  printf "  ${C_DIM}%-10s %-34s %-22s %s${C_RESET}\n" "──────────" "──────────────────────────────────" "──────────────────────" "───────────────────────────"

  while IFS=$'\t' read -r comp repo_rel target_rel desc; do
    [[ -z "$comp" || "$comp" =~ ^# ]] && continue
    matches_filter "$comp" "$filter" || continue

    local repo_file="$REPO_ROOT/$repo_rel"
    local target_file="$HOME/$target_rel"
    local status_str=""

    if [[ ! -f "$repo_file" && ! -f "$target_file" ]]; then
      status_str="${C_RED}✖ MISSING (both)${C_RESET}"
      ((missing+=1))
    elif [[ ! -f "$repo_file" ]]; then
      status_str="${C_YELLOW}◌ UNCOLLECTED${C_RESET}"
      ((missing+=1))
    elif [[ ! -f "$target_file" ]]; then
      status_str="${C_YELLOW}✖ MISSING (local)${C_RESET}"
      ((missing+=1))
    elif cmp -s "$repo_file" "$target_file"; then
      status_str="${C_GREEN}✔ IN SYNC${C_RESET}"
      ((in_sync+=1))
    else
      local repo_mtime target_mtime
      repo_mtime="$(stat -c %Y "$repo_file" 2>/dev/null || echo 0)"
      target_mtime="$(stat -c %Y "$target_file" 2>/dev/null || echo 0)"
      if (( target_mtime > repo_mtime )); then
        status_str="${C_YELLOW}⚡ DRIFT (local newer)${C_RESET}"
      else
        status_str="${C_CYAN}⚡ DRIFT (repo newer)${C_RESET}"
      fi
      ((drifted+=1))
    fi

    printf "  %-10s %-34s %-33s ${C_DIM}%s${C_RESET}\n" "$comp" "~/$target_rel" "$status_str" "$desc"
  done < "$MANIFEST"

  # Check Konsole colorschemes directory summary
  if matches_filter "konsole" "$filter"; then
    local cs_repo_dir="$REPO_ROOT/configs/konsole/colorschemes"
    local cs_live_dir="$HOME/.local/share/konsole"
    local cs_total=0 cs_drift=0
    if [[ -d "$cs_repo_dir" ]]; then
      while IFS= read -r -d '' cs_file; do
        ((cs_total+=1))
        local base
        base="$(basename "$cs_file")"
        if [[ ! -f "$cs_live_dir/$base" ]] || ! cmp -s "$cs_file" "$cs_live_dir/$base"; then
          ((cs_drift+=1))
        fi
      done < <(find "$cs_repo_dir" -maxdepth 1 -name '*.colorscheme' -type f -print0)
    fi
    local cs_status
    if (( cs_total == 0 )); then
      cs_status="${C_YELLOW}◌ UNCOLLECTED${C_RESET}"
    elif (( cs_drift == 0 )); then
      cs_status="${C_GREEN}✔ IN SYNC (${cs_total} themes)${C_RESET}"
      ((in_sync+=1))
    else
      cs_status="${C_YELLOW}⚡ DRIFT (${cs_drift}/${cs_total} differ)${C_RESET}"
      ((drifted+=1))
    fi
    printf "  %-10s %-34s %-33s ${C_DIM}%s${C_RESET}\n" "konsole" "~/.local/share/konsole/*.colorscheme" "$cs_status" "Konsole color palettes"
  fi

  printf "\n  ${C_BOLD}Summary:${C_RESET} ${C_GREEN}%d in sync${C_RESET} · ${C_YELLOW}%d drifted${C_RESET} · ${C_RED}%d missing${C_RESET}\n" "$in_sync" "$drifted" "$missing"

  if [[ -d "$REPO_ROOT/.git" ]]; then
    local git_changes
    git_changes="$(git -C "$REPO_ROOT" status --porcelain 2>/dev/null | wc -l)"
    if (( git_changes > 0 )); then
      printf "  ${C_BOLD}Git Repo:${C_RESET}    ${C_YELLOW}%d uncommitted change(s) in repository${C_RESET} (run ${C_CYAN}git -C %s status${C_RESET})\n" "$git_changes" "$REPO_ROOT"
    else
      printf "  ${C_BOLD}Git Repo:${C_RESET}    ${C_GREEN}working tree clean${C_RESET}\n"
    fi

    local upstream ahead=0 behind=0 last_epoch age auto_check remote_msg=""
    upstream="$(get_git_upstream)"
    if [[ -n "$upstream" ]] && git -C "$REPO_ROOT" rev-parse --verify --quiet "$upstream" >/dev/null 2>&1; then
      local counts
      counts="$(git -C "$REPO_ROOT" rev-list --left-right --count "HEAD...${upstream}" 2>/dev/null || echo "0 0")"
      read -r ahead behind <<< "$counts"
      ahead="${ahead:-0}"
      behind="${behind:-0}"
    fi
    last_epoch="$(read_kv_file_key "$UPDATE_CACHE_FILE" "LAST_CHECK_EPOCH" "0")"
    age="$(format_epoch_age "$last_epoch")"
    auto_check="$(read_kv_file_key "$DOTS_CONFIG_FILE" "UPDATE_CHECK" "1")"

    if [[ -z "$upstream" ]]; then
      remote_msg="${C_DIM}no upstream tracking branch${C_RESET}"
    elif (( behind > 0 && ahead > 0 )); then
      remote_msg="${C_YELLOW}diverged from ${upstream} (${ahead} ahead, ${behind} behind)${C_RESET} ${C_DIM}· checked ${age}${C_RESET}"
    elif (( behind > 0 )); then
      remote_msg="${C_YELLOW}${behind} commit(s) behind ${upstream}${C_RESET} (run ${C_CYAN}dots update${C_RESET}) ${C_DIM}· checked ${age}${C_RESET}"
    elif (( ahead > 0 )); then
      remote_msg="${C_CYAN}${ahead} commit(s) ahead of ${upstream}${C_RESET} ${C_DIM}· checked ${age}${C_RESET}"
    else
      remote_msg="${C_GREEN}up to date with ${upstream}${C_RESET} ${C_DIM}· checked ${age}${C_RESET}"
    fi
    [[ "$auto_check" == "0" ]] && remote_msg+=" ${C_DIM}· auto-check off${C_RESET}"
    printf "  ${C_BOLD}Remote Sync:${C_RESET} %s\n" "$remote_msg"
  fi
  printf "\n"
}

# -----------------------------------------------------------------------------
# Command: diff
# -----------------------------------------------------------------------------
cmd_diff() {
  local filter="profile"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --profile)
        CLI_PROFILE_OVERRIDE="${2:-}"
        validate_cli_profile_override
        shift 2
        ;;
      --profile=*)
        CLI_PROFILE_OVERRIDE="${1#*=}"
        validate_cli_profile_override
        shift
        ;;
      *)
        filter="$1"
        shift
        ;;
    esac
  done

  local found_diff=0

  while IFS=$'\t' read -r comp repo_rel target_rel desc; do
    [[ -z "$comp" || "$comp" =~ ^# ]] && continue
    matches_filter "$comp" "$filter" || continue

    local repo_file="$REPO_ROOT/$repo_rel"
    local target_file="$HOME/$target_rel"

    if [[ -f "$repo_file" && -f "$target_file" ]]; then
      if ! cmp -s "$repo_file" "$target_file"; then
        found_diff=1
        printf "\n${C_BOLD}${C_MAUVE}═══ Diff [%s]: repo (%s) vs live (~/%s) ═══${C_RESET}\n" "$comp" "$repo_rel" "$target_rel"
        if command -v delta >/dev/null 2>&1; then
          git diff --no-index "$repo_file" "$target_file" | delta --paging=never || true
        else
          git diff --no-index --color=always "$repo_file" "$target_file" || true
        fi
      fi
    elif [[ ! -f "$repo_file" && -f "$target_file" ]]; then
      found_diff=1
      log_warn "[$comp] ~/$target_rel exists locally but is not yet collected in repo."
    elif [[ -f "$repo_file" && ! -f "$target_file" ]]; then
      found_diff=1
      log_warn "[$comp] $repo_rel exists in repo but is missing at ~/$target_rel."
    fi
  done < "$MANIFEST"

  if matches_filter "konsole" "$filter" && [[ -d "$REPO_ROOT/configs/konsole/colorschemes" ]]; then
    while IFS= read -r -d '' cs_file; do
      local base
      base="$(basename "$cs_file")"
      local live_cs="$HOME/.local/share/konsole/$base"
      if [[ -f "$live_cs" ]] && ! cmp -s "$cs_file" "$live_cs"; then
        found_diff=1
        printf "\n${C_BOLD}${C_MAUVE}═══ Diff [konsole/colorscheme]: %s ═══${C_RESET}\n" "$base"
        git diff --no-index --color=always "$cs_file" "$live_cs" || true
      fi
    done < <(find "$REPO_ROOT/configs/konsole/colorschemes" -maxdepth 1 -name '*.colorscheme' -type f -print0)
  fi

  if (( found_diff == 0 )); then
    log_ok "No differences between repository and live system ($(format_filter_label "$filter"))."
  fi
}

# -----------------------------------------------------------------------------
# Command: collect (Live System ~/ -> Repository)
# -----------------------------------------------------------------------------
cmd_collect() {
  local filter="profile"
  local commit_msg=""
  local do_push=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -c|--commit)
        commit_msg="${2:-}"
        shift 2
        ;;
      -p|--push)
        do_push=1
        shift
        ;;
      --profile)
        CLI_PROFILE_OVERRIDE="${2:-}"
        validate_cli_profile_override
        shift 2
        ;;
      --profile=*)
        CLI_PROFILE_OVERRIDE="${1#*=}"
        validate_cli_profile_override
        shift
        ;;
      *)
        filter="$1"
        shift
        ;;
    esac
  done

  local count=0
  while IFS=$'\t' read -r comp repo_rel target_rel desc; do
    [[ -z "$comp" || "$comp" =~ ^# ]] && continue
    matches_filter "$comp" "$filter" || continue

    local repo_file="$REPO_ROOT/$repo_rel"
    local target_file="$HOME/$target_rel"

    if [[ -f "$target_file" ]]; then
      mkdir -p "$(dirname "$repo_file")"
      if [[ ! -f "$repo_file" ]] || ! cmp -s "$target_file" "$repo_file"; then
        cp -p "$target_file" "$repo_file"
        log_ok "Collected [$comp] ~/$target_rel -> $repo_rel"
        ((count+=1))
      fi
    else
      log_warn "Skipped [$comp] ~/$target_rel (file not found on live system)"
    fi
  done < "$MANIFEST"

  # Collect valid Konsole colorschemes
  if matches_filter "konsole" "$filter" && [[ -d "$HOME/.local/share/konsole" ]]; then
    local cs_dest="$REPO_ROOT/configs/konsole/colorschemes"
    mkdir -p "$cs_dest"
    while IFS= read -r -d '' live_cs; do
      local base
      base="$(basename "$live_cs")"
      # Validate colorscheme file (skip broken 404 files)
      if grep -q '^\[Background\]' "$live_cs" 2>/dev/null; then
        if [[ ! -f "$cs_dest/$base" ]] || ! cmp -s "$live_cs" "$cs_dest/$base"; then
          cp -p "$live_cs" "$cs_dest/$base"
          log_ok "Collected [konsole] colorscheme: $base"
          ((count+=1))
        fi
      else
        log_warn "Skipped invalid Konsole colorscheme: $base (missing [Background] header)"
      fi
    done < <(find "$HOME/.local/share/konsole" -maxdepth 1 -name '*.colorscheme' -type f -print0)
  fi

  # Run secret scan gate
  if ! scan_secrets; then
    log_err "Secret hygiene gate failed! Please remove sensitive tokens before committing."
    exit 1
  fi

  if (( count == 0 )); then
    log_info "All tracked files for '$(format_filter_label "$filter")' are already up to date in the repository."
  else
    log_ok "Collected $count updated file(s) into repository."
  fi

  if [[ -n "$commit_msg" && -d "$REPO_ROOT/.git" ]]; then
    git -C "$REPO_ROOT" add configs/
    if ! git -C "$REPO_ROOT" diff --cached --quiet; then
      git -C "$REPO_ROOT" commit -m "$commit_msg"
      log_ok "Committed changes: $commit_msg"
      if (( do_push == 1 )); then
        git -C "$REPO_ROOT" push
        log_ok "Pushed changes to remote origin."
        refresh_update_cache_from_git "$(date +%s)"
      fi
    else
      log_info "No staged changes to commit."
    fi
  fi
}

# -----------------------------------------------------------------------------
# Command: apply (Repository -> Live System ~/)
# -----------------------------------------------------------------------------
cmd_apply() {
  local filter="profile"
  local no_backup=0
  local dry_run=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-backup) no_backup=1; shift ;;
      --dry-run|-n) dry_run=1; shift ;;
      --profile)
        CLI_PROFILE_OVERRIDE="${2:-}"
        validate_cli_profile_override
        shift 2
        ;;
      --profile=*)
        CLI_PROFILE_OVERRIDE="${1#*=}"
        validate_cli_profile_override
        shift
        ;;
      *) filter="$1"; shift ;;
    esac
  done

  local ts
  ts="$(date +%Y%m%d_%H%M%S)"
  local backup_dir="$BACKUP_ROOT/$ts"
  local backed_up=0
  local applied=0

  while IFS=$'\t' read -r comp repo_rel target_rel desc; do
    [[ -z "$comp" || "$comp" =~ ^# ]] && continue
    matches_filter "$comp" "$filter" || continue

    local repo_file="$REPO_ROOT/$repo_rel"
    local target_file="$HOME/$target_rel"

    if [[ ! -f "$repo_file" ]]; then
      log_warn "Skipped [$comp] $repo_rel (not present in repo)"
      continue
    fi

    if [[ -f "$target_file" ]] && cmp -s "$repo_file" "$target_file"; then
      continue
    fi

    if (( dry_run == 1 )); then
      log_info "[DRY-RUN] Would apply $repo_rel -> ~/$target_rel"
      ((applied+=1))
      continue
    fi

    if [[ -f "$target_file" ]] && (( no_backup == 0 )); then
      mkdir -p "$(dirname "$backup_dir/$target_rel")"
      cp -p "$target_file" "$backup_dir/$target_rel"
      ((backed_up+=1))
    fi

    mkdir -p "$(dirname "$target_file")"
    cp -p "$repo_file" "$target_file"
    log_ok "Applied [$comp] $repo_rel -> ~/$target_rel"
    ((applied+=1))
  done < "$MANIFEST"

  # Apply Konsole colorschemes
  if matches_filter "konsole" "$filter" && [[ -d "$REPO_ROOT/configs/konsole/colorschemes" ]]; then
    local cs_live_dir="$HOME/.local/share/konsole"
    mkdir -p "$cs_live_dir"
    while IFS= read -r -d '' cs_file; do
      local base
      base="$(basename "$cs_file")"
      local target_cs="$cs_live_dir/$base"
      if [[ -f "$target_cs" ]] && cmp -s "$cs_file" "$target_cs"; then
        continue
      fi
      if (( dry_run == 1 )); then
        log_info "[DRY-RUN] Would apply colorscheme: $base"
        ((applied+=1))
        continue
      fi
      if [[ -f "$target_cs" ]] && (( no_backup == 0 )); then
        mkdir -p "$backup_dir/.local/share/konsole"
        cp -p "$target_cs" "$backup_dir/.local/share/konsole/$base"
        ((backed_up+=1))
      fi
      cp -p "$cs_file" "$target_cs"
      log_ok "Applied [konsole] colorscheme -> ~/.local/share/konsole/$base"
      ((applied+=1))
    done < <(find "$REPO_ROOT/configs/konsole/colorschemes" -maxdepth 1 -name '*.colorscheme' -type f -print0)
  fi

  if (( backed_up > 0 )); then
    log_info "Created backup snapshot of $backed_up overwritten file(s) at: $backup_dir"
  fi

  if (( applied == 0 )); then
    log_ok "Live environment is already in sync with repository ($(format_filter_label "$filter"))."
  else
    log_ok "Applied $applied configuration file(s) ($(format_filter_label "$filter"))."
  fi
}

# -----------------------------------------------------------------------------
# Command: profile (Machine Environment Profile Selector)
# -----------------------------------------------------------------------------
cmd_profile() {
  local sub="${1:-}"
  if [[ -z "$sub" ]]; then
    if [[ -t 0 && -t 1 ]]; then
      sub="select"
    else
      sub="list"
    fi
  else
    shift || true
  fi

  case "$sub" in
    list|ls)
      local active source_kind suggested
      active="$(get_active_profile)"
      source_kind="$(get_profile_source)"
      suggested="$(detect_suggested_profile)"

      printf "\n${C_BOLD}${C_MAUVE}=== Machine Profiles ===${C_RESET}\n"
      printf "  Active: ${C_CYAN}%s${C_RESET} ${C_DIM}(%s)${C_RESET} · Auto-detected: ${C_GREEN}%s${C_RESET}\n" "$active" "$source_kind" "$suggested"
      printf "  Config: ${C_DIM}%s${C_RESET}\n\n" "$DOTS_CONFIG_FILE"

      local p comps flags fonts desc
      while IFS=$'\t' read -r p comps flags fonts desc; do
        [[ -z "$p" || "$p" =~ ^# ]] && continue
        local tags=""
        [[ "$p" == "$active" ]] && tags+=" ${C_GREEN}[active]${C_RESET}"
        [[ "$p" == "$suggested" ]] && tags+=" ${C_DIM}[suggested]${C_RESET}"
        if [[ "$p" == "$active" ]]; then
          printf "  ${C_GREEN}● %-9s${C_RESET} %s%s\n" "$p" "$desc" "$tags"
        else
          printf "  ${C_DIM}○${C_RESET} %-9s %s%s\n" "$p" "$desc" "$tags"
        fi
        printf "    ${C_DIM}components: %s · bootstrap: %s · fonts: %s${C_RESET}\n" "$comps" "$flags" "$([[ "$fonts" == "1" ]] && echo yes || echo no)"
      done < "$PROFILES_FILE"
      printf "\n${C_DIM}Switch interactively: dots profile  OR  non-interactively: dots profile set <name> [--apply]${C_RESET}\n\n"
      ;;

    get|current)
      get_active_profile
      ;;

    flags|bootstrap-flags)
      local target="${1:-}"
      if [[ -z "$target" ]]; then
        target="$(get_active_profile)"
      else
        target="$(normalize_profile_name "$target")"
        if ! is_valid_profile "$target"; then
          log_err "Unknown profile '$1'. Valid profiles: desktop, wsl, server, minimal"
          exit 1
        fi
      fi
      get_profile_field "$target" 3
      ;;

    check-fonts)
      local target="${1:-}"
      if [[ -z "$target" ]]; then
        target="$(get_active_profile)"
      else
        target="$(normalize_profile_name "$target")"
        if ! is_valid_profile "$target"; then
          log_err "Unknown profile '$1'. Valid profiles: desktop, wsl, server, minimal"
          exit 1
        fi
      fi
      get_profile_field "$target" 4
      ;;

    show|preview)
      local target="${1:-}"
      if [[ -z "$target" ]]; then
        target="$(get_active_profile)"
      else
        target="$(normalize_profile_name "$target")"
      fi
      if ! is_valid_profile "$target"; then
        log_err "Unknown profile '$target'."
        exit 1
      fi
      local comps flags fonts desc
      comps="$(get_profile_field "$target" 2)"
      flags="$(get_profile_field "$target" 3)"
      fonts="$(get_profile_field "$target" 4)"
      desc="$(get_profile_field "$target" 5)"

      printf "${C_BOLD}${C_MAUVE}Profile:${C_RESET} ${C_CYAN}%s${C_RESET}\n" "$target"
      printf "${C_DIM}%s${C_RESET}\n\n" "$desc"
      printf "${C_BOLD}Bootstrap steps:${C_RESET} %s\n" "$flags"
      printf "${C_BOLD}Check/install fonts:${C_RESET} %s\n\n" "$([[ "$fonts" == "1" ]] && echo yes || echo no)"
      printf "${C_BOLD}Tracked targets:${C_RESET}\n"
      local comp repo_rel target_rel _m_desc
      while IFS=$'\t' read -r comp repo_rel target_rel _m_desc; do
        [[ -z "$comp" || "$comp" =~ ^# ]] && continue
        if profile_has_component "$target" "$comp"; then
          printf "  ${C_GREEN}✔${C_RESET} %-10s ~/%s\n" "$comp" "$target_rel"
        fi
      done < "$MANIFEST"
      if profile_has_component "$target" "konsole"; then
        printf "  ${C_GREEN}✔${C_RESET} %-10s ~/.local/share/konsole/*.colorscheme\n" "konsole"
      fi
      ;;

    set)
      local target="" do_apply=0
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --apply) do_apply=1; shift ;;
          *) target="$1"; shift ;;
        esac
      done
      if [[ -z "$target" ]]; then
        log_err "Usage: dots profile set <desktop|wsl|server|minimal> [--apply]"
        exit 1
      fi
      local norm
      norm="$(normalize_profile_name "$target")"
      if ! is_valid_profile "$norm"; then
        log_err "Unknown profile '$target'. Valid profiles: desktop, wsl, server, minimal"
        exit 1
      fi
      write_local_config_key "PROFILE" "$norm"
      CLI_PROFILE_OVERRIDE=""
      log_ok "Active machine profile set to '${norm}' (saved in $DOTS_CONFIG_FILE)."
      if (( do_apply == 1 )); then
        printf "\n"
        cmd_apply profile
      fi
      ;;

    auto)
      local do_apply=0
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --apply) do_apply=1; shift ;;
          *) log_err "Unknown option for 'dots profile auto': $1"; exit 1 ;;
        esac
      done
      local suggested
      suggested="$(detect_suggested_profile)"
      write_local_config_key "PROFILE" "$suggested"
      CLI_PROFILE_OVERRIDE=""
      log_ok "Auto-detected machine profile '${suggested}' saved to $DOTS_CONFIG_FILE."
      if (( do_apply == 1 )); then
        printf "\n"
        cmd_apply profile
      fi
      ;;

    select)
      if [[ ! -t 0 || ! -t 1 ]]; then
        log_err "Interactive profile selector requires a TTY. Use 'dots profile list' or 'dots profile set <name>'."
        exit 1
      fi

      local active source_kind suggested chosen=""
      active="$(get_active_profile)"
      source_kind="$(get_profile_source)"
      suggested="$(detect_suggested_profile)"

      if command -v fzf >/dev/null 2>&1; then
        local rows=() p comps flags fonts desc
        while IFS=$'\t' read -r p comps flags fonts desc; do
          [[ -z "$p" || "$p" =~ ^# ]] && continue
          local tags=""
          [[ "$p" == "$active" ]] && tags+=" [active]"
          [[ "$p" == "$suggested" ]] && tags+=" [suggested]"
          rows+=("$(printf '%s\t%-9s %s%s' "$p" "$p" "$desc" "$tags")")
        done < "$PROFILES_FILE"

        local self_quoted selection="" rc=0
        self_quoted="$(printf '%q' "$SOURCE_PATH")"
        set +e
        selection="$(printf '%s\n' "${rows[@]}" | fzf \
          --delimiter=$'\t' \
          --with-nth=2.. \
          --height=45% \
          --layout=reverse \
          --border=rounded \
          --prompt="Profile ▶ " \
          --header="Active: ${active} (${source_kind}) · Suggested: ${suggested}" \
          --preview="${self_quoted} profile show {1}" \
          --preview-window="right:50%:wrap" \
          --color="fg:#839496,bg:#002b36,hl:#b58900,fg+:#eee8d5,bg+:#073642,hl+:#cb4b16,info:#268bd2,prompt:#859900,pointer:#2aa198,marker:#859900,header:#586e75,border:#073642")"
        rc=$?
        set -e

        if (( rc != 0 )) || [[ -z "$selection" ]]; then
          log_info "Profile selection cancelled."
          return 0
        fi
        chosen="${selection%%$'\t'*}"
      else
        printf "\n${C_BOLD}${C_MAUVE}=== Select Machine Profile ===${C_RESET}\n"
        printf "  Active: ${C_CYAN}%s${C_RESET} (%s) · Suggested: ${C_GREEN}%s${C_RESET}\n\n" "$active" "$source_kind" "$suggested"
        local profiles=() idx=1 p comps flags fonts desc
        while IFS=$'\t' read -r p comps flags fonts desc; do
          [[ -z "$p" || "$p" =~ ^# ]] && continue
          profiles+=("$p")
          local marker=" "
          [[ "$p" == "$active" ]] && marker="${C_GREEN}●${C_RESET}"
          local tag=""
          [[ "$p" == "$suggested" ]] && tag=" ${C_DIM}[suggested]${C_RESET}"
          printf "  %s %d) ${C_BOLD}%-9s${C_RESET} %s%s\n" "$marker" "$idx" "$p" "$desc" "$tag"
          ((idx+=1))
        done < "$PROFILES_FILE"

        printf "\n"
        local choice=""
        read -r -p "Choose profile [1-${#profiles[@]}] or name (Enter = ${active}): " choice
        if [[ -z "$choice" ]]; then
          chosen="$active"
        elif [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#profiles[@]} )); then
          chosen="${profiles[$((choice - 1))]}"
        else
          chosen="$(normalize_profile_name "$choice")"
        fi

        if ! is_valid_profile "$chosen"; then
          log_err "Invalid profile selection '$choice'."
          exit 1
        fi
      fi

      write_local_config_key "PROFILE" "$chosen"
      CLI_PROFILE_OVERRIDE=""
      log_ok "Active machine profile set to '${chosen}' (saved in $DOTS_CONFIG_FILE)."

      local apply_now="n"
      read -r -p "Apply '${chosen}' profile configs to ~/ now? [y/N]: " apply_now
      if [[ "$apply_now" =~ ^[Yy]$ ]]; then
        printf "\n"
        cmd_apply profile
      fi
      ;;

    *)
      log_err "Unknown profile subcommand: $sub (expected: select, list, get, set, auto, show, flags)"
      exit 1
      ;;
  esac
}

# -----------------------------------------------------------------------------
# Command: check-update (Upstream Git Update Checker & Cache)
# -----------------------------------------------------------------------------
cmd_check_update() {
  local quiet=0
  local cached_only=0
  local action=""
  local interval_val=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --quiet|-q) quiet=1; shift ;;
      --cached) cached_only=1; shift ;;
      --enable) action="enable"; shift ;;
      --disable) action="disable"; shift ;;
      --interval)
        interval_val="${2:-}"
        if [[ -z "$interval_val" || ! "$interval_val" =~ ^[1-9][0-9]*$ ]]; then
          log_err "Usage: dots check-update --interval <hours> (positive integer)"
          exit 1
        fi
        action="interval"
        shift 2
        ;;
      --interval=*)
        interval_val="${1#*=}"
        if [[ -z "$interval_val" || ! "$interval_val" =~ ^[1-9][0-9]*$ ]]; then
          log_err "Usage: dots check-update --interval <hours> (positive integer)"
          exit 1
        fi
        action="interval"
        shift
        ;;
      *)
        log_err "Unknown option for check-update: $1"
        exit 1
        ;;
    esac
  done

  if [[ "$action" == "enable" ]]; then
    write_local_config_key "UPDATE_CHECK" "1"
    log_ok "Background update check enabled in $DOTS_CONFIG_FILE."
    return 0
  elif [[ "$action" == "disable" ]]; then
    write_local_config_key "UPDATE_CHECK" "0"
    log_ok "Background update check disabled in $DOTS_CONFIG_FILE."
    return 0
  elif [[ "$action" == "interval" ]]; then
    write_local_config_key "UPDATE_INTERVAL_HOURS" "$interval_val"
    log_ok "Background update check interval set to ${interval_val}h in $DOTS_CONFIG_FILE."
    return 0
  fi

  if [[ ! -d "$REPO_ROOT/.git" ]]; then
    if (( quiet == 1 )); then
      return 0
    fi
    log_err "Not a git repository: $REPO_ROOT"
    exit 1
  fi

  local upstream remote
  upstream="$(get_git_upstream)"
  remote="origin"
  if [[ "$upstream" == */* ]]; then
    remote="${upstream%%/*}"
  fi

  if (( quiet == 1 )); then
    local lock_dir="$DOTS_CACHE_DIR/update-check.lock"
    mkdir -p "$DOTS_CACHE_DIR"
    if ! mkdir "$lock_dir" 2>/dev/null; then
      local now mtime
      now="$(date +%s)"
      mtime="$(stat -c %Y "$lock_dir" 2>/dev/null || echo "$now")"
      if (( now - mtime > 120 )); then
        rmdir "$lock_dir" 2>/dev/null || rm -rf "$lock_dir" 2>/dev/null || true
        mkdir "$lock_dir" 2>/dev/null || return 0
      else
        return 0
      fi
    fi

    if (( cached_only == 1 )); then
      refresh_update_cache_from_git ""
    elif run_git_fetch "$remote"; then
      refresh_update_cache_from_git "$(date +%s)"
    else
      local interval_h now backoff_epoch
      interval_h="$(read_kv_file_key "$DOTS_CONFIG_FILE" "UPDATE_INTERVAL_HOURS" "12")"
      [[ "$interval_h" =~ ^[1-9][0-9]*$ ]] || interval_h=12
      now="$(date +%s)"
      backoff_epoch=$(( now - (interval_h * 3600) + 900 ))
      (( backoff_epoch < 0 )) && backoff_epoch=0
      refresh_update_cache_from_git "$backoff_epoch"
    fi

    rmdir "$lock_dir" 2>/dev/null || true
    return 0
  fi

  if (( cached_only == 0 )); then
    log_info "Checking upstream '${remote}' for updates..."
    if run_git_fetch "$remote"; then
      refresh_update_cache_from_git "$(date +%s)"
    else
      log_warn "Could not reach remote '${remote}' (offline or auth unavailable). Showing cached/local state."
      refresh_update_cache_from_git ""
    fi
  else
    refresh_update_cache_from_git ""
  fi

  local behind ahead cached_upstream last_epoch age auto_check interval_h
  behind="$(read_kv_file_key "$UPDATE_CACHE_FILE" "REMOTE_BEHIND" "0")"
  ahead="$(read_kv_file_key "$UPDATE_CACHE_FILE" "REMOTE_AHEAD" "0")"
  cached_upstream="$(read_kv_file_key "$UPDATE_CACHE_FILE" "UPSTREAM" "${upstream:-none}")"
  last_epoch="$(read_kv_file_key "$UPDATE_CACHE_FILE" "LAST_CHECK_EPOCH" "0")"
  age="$(format_epoch_age "$last_epoch")"
  auto_check="$(read_kv_file_key "$DOTS_CONFIG_FILE" "UPDATE_CHECK" "1")"
  interval_h="$(read_kv_file_key "$DOTS_CONFIG_FILE" "UPDATE_INTERVAL_HOURS" "12")"

  if [[ "$cached_upstream" == "none" || -z "$cached_upstream" ]]; then
    log_warn "No upstream branch configured for HEAD."
  elif (( behind > 0 && ahead > 0 )); then
    log_warn "Local branch diverged from ${cached_upstream} (${ahead} ahead, ${behind} behind):"
    git -C "$REPO_ROOT" log --oneline "HEAD..${cached_upstream}" 2>/dev/null | sed 's/^/    remote: /' || true
    git -C "$REPO_ROOT" log --oneline "${cached_upstream}..HEAD" 2>/dev/null | sed 's/^/    local:  /' || true
    log_info "Reconcile git history manually (e.g. 'git pull --rebase' in $REPO_ROOT) before running 'dots update'."
  elif (( behind > 0 )); then
    log_warn "${behind} new commit(s) available on ${cached_upstream}:"
    git -C "$REPO_ROOT" log --oneline "HEAD..${cached_upstream}" 2>/dev/null | sed 's/^/    /' || true
    log_info "Run 'dots update' (or 'dupdate') to pull and apply."
  elif (( ahead > 0 )); then
    log_info "Local branch is ${ahead} commit(s) ahead of ${cached_upstream}."
  else
    log_ok "Repository is up to date with ${cached_upstream}."
  fi

  printf "  ${C_DIM}Auto-check: %s · interval: %sh · last check: %s${C_RESET}\n" \
    "$([[ "$auto_check" == "1" ]] && echo enabled || echo disabled)" \
    "$interval_h" \
    "$age"
}

# -----------------------------------------------------------------------------
# Command: theme (Switch Konsole ColorScheme or Zsh Prompt Engine)
# -----------------------------------------------------------------------------
cmd_theme() {
  local sub="${1:-list}"
  shift || true

  case "$sub" in
    list)
      local active_cs active_prompt
      active_cs="$(get_active_konsole_scheme)"
      active_prompt="$(get_active_prompt_engine)"

      printf "\n${C_BOLD}${C_MAUVE}=== Prompt Engines ===${C_RESET}\n"
      for p in powerlevel10k starship; do
        if [[ "$p" == "$active_prompt" ]]; then
          printf "  ${C_GREEN}● %-16s (active)${C_RESET}\n" "$p"
        else
          printf "  ${C_DIM}○ %-16s${C_RESET}\n" "$p"
        fi
      done

      printf "\n${C_BOLD}${C_MAUVE}=== Konsole Color Schemes ===${C_RESET}\n"
      local cs_dir="$REPO_ROOT/configs/konsole/colorschemes"
      [[ ! -d "$cs_dir" ]] && cs_dir="$HOME/.local/share/konsole"
      while IFS= read -r -d '' f; do
        local name
        name="$(basename "$f" .colorscheme)"
        local desc
        desc="$(grep -E '^Description=' "$f" 2>/dev/null | head -n1 | cut -d= -f2- || echo "$name")"
        if [[ "$name" == "$active_cs" ]]; then
          printf "  ${C_GREEN}● %-30s${C_RESET} ${C_DIM}(%s) [active]${C_RESET}\n" "$name" "$desc"
        else
          printf "  ${C_DIM}○${C_RESET} %-30s ${C_DIM}(%s)${C_RESET}\n" "$name" "$desc"
        fi
      done < <(find "$cs_dir" -maxdepth 1 -name '*.colorscheme' -type f -print0 | sort -z)
      printf "\n${C_DIM}Switch with: dots theme konsole <name>  OR  dots theme prompt <p10k|starship>${C_RESET}\n\n"
      ;;

    konsole)
      local scheme="${1:-}"
      if [[ -z "$scheme" ]]; then
        log_err "Usage: dots theme konsole <scheme-name>"
        exit 1
      fi
      scheme="${scheme%.colorscheme}"
      local cs_file="$HOME/.local/share/konsole/${scheme}.colorscheme"
      local repo_cs="$REPO_ROOT/configs/konsole/colorschemes/${scheme}.colorscheme"
      if [[ ! -f "$cs_file" && -f "$repo_cs" ]]; then
        mkdir -p "$HOME/.local/share/konsole"
        cp -p "$repo_cs" "$cs_file"
      fi
      if [[ ! -f "$cs_file" ]]; then
        log_err "Colorscheme '${scheme}' not found in ~/.local/share/konsole or repo."
        exit 1
      fi
      local profile="$HOME/.local/share/konsole/zsh.profile"
      if [[ -f "$profile" ]]; then
        sed -i "s/^ColorScheme=.*/ColorScheme=${scheme}/" "$profile"
        log_ok "Updated ~/.local/share/konsole/zsh.profile -> ColorScheme=${scheme}"
      fi
      if command -v konsoleprofile >/dev/null 2>&1 && [[ -n "${KONSOLE_DBUS_SESSION:-}" ]]; then
        konsoleprofile "colors=${scheme}" 2>/dev/null || true
      fi
      log_info "Run 'dots collect konsole' if you want to save this theme as default in the repo."
      ;;

    prompt)
      local engine="${1:-}"
      local zshrc="$HOME/.zshrc"
      if [[ ! -f "$zshrc" ]]; then
        log_err "~/.zshrc not found."
        exit 1
      fi
      case "$engine" in
        p10k|powerlevel10k)
          sed -i 's/^[[:space:]]*eval "\$(starship init zsh)"/# eval "$(starship init zsh)"/' "$zshrc"
          sed -i 's/^#[[:space:]]*\(\[\[ ! -f ~\/\.p10k\.zsh \]\] || source ~\/\.p10k\.zsh\)/\1/' "$zshrc"
          sed -i 's/^#[[:space:]]*\(zinit ice depth=1; zinit light romkatv\/powerlevel10k\)/\1/' "$zshrc"
          log_ok "Switched active Zsh prompt to Powerlevel10k. Run 'source ~/.zshrc' to reload."
          ;;
        starship)
          if ! command -v starship >/dev/null 2>&1; then
            log_warn "starship binary not found in PATH! Install it first (curl -sS https://starship.rs/install.sh | sh)."
          fi
          sed -i 's/^\(zinit ice depth=1; zinit light romkatv\/powerlevel10k\)/# \1/' "$zshrc"
          sed -i 's/^\(\[\[ ! -f ~\/\.p10k\.zsh \]\] || source ~\/\.p10k\.zsh\)/# \1/' "$zshrc"
          if grep -qE 'eval "\$\(starship init zsh\)"' "$zshrc"; then
            sed -i 's/^#[[:space:]]*\(eval "\$(starship init zsh)"\)/\1/' "$zshrc"
          else
            printf '\n# Starship Prompt\neval "$(starship init zsh)"\n' >> "$zshrc"
          fi
          log_ok "Switched active Zsh prompt to Starship (Tactical theme). Run 'source ~/.zshrc' to reload."
          ;;
        *)
          log_err "Usage: dots theme prompt <p10k|starship>"
          exit 1
          ;;
      esac
      ;;

    *)
      log_err "Unknown theme subcommand: $sub (expected: list, konsole, prompt)"
      exit 1
      ;;
  esac
}

# -----------------------------------------------------------------------------
# Command: doctor
# -----------------------------------------------------------------------------
cmd_doctor() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --profile)
        CLI_PROFILE_OVERRIDE="${2:-}"
        validate_cli_profile_override
        shift 2
        ;;
      --profile=*)
        CLI_PROFILE_OVERRIDE="${1#*=}"
        validate_cli_profile_override
        shift
        ;;
      *)
        log_err "Unknown option for doctor: $1"
        exit 1
        ;;
    esac
  done

  # O installer coloca binarios em ~/.local/bin (starship, uv, rg, fd...) e em
  # ~/.atuin/bin, mas um bash de login pode nao ter esses diretorios no PATH
  # (tipico em host recem-criado via SSH). Sem este export o doctor acusava
  # starship/uv como MISSING mesmo depois de instalados.
  export PATH="$HOME/.local/bin:$HOME/.atuin/bin:$PATH"

  local active_profile profile_source check_fonts req_pkg=1
  active_profile="$(get_active_profile)"
  profile_source="$(get_profile_source)"
  check_fonts="$(get_profile_field "$active_profile" 4 || echo 1)"
  [[ "$active_profile" == "minimal" ]] && req_pkg=0

  printf "\n${C_BOLD}${C_MAUVE}=== Dotfiles & Terminal Environment Doctor ===${C_RESET}\n"
  printf "  Machine Profile: ${C_CYAN}%s${C_RESET} ${C_DIM}(%s)${C_RESET}\n\n" "$active_profile" "$profile_source"

  local ok_count=0 warn_count=0

  check_bin() {
    local bin="$1" role="$2" extra_path="${3:-}" required="${4:-1}"
    local resolved=""
    if command -v "$bin" >/dev/null 2>&1; then
      resolved="$(command -v "$bin")"
    elif [[ -n "$extra_path" && -x "$extra_path" ]]; then
      resolved="$extra_path"
    fi

    if [[ -n "$resolved" ]]; then
      local ver
      ver="$("$resolved" --version 2>/dev/null | grep -vE '^eza - A modern|^$' | head -n1 | cut -c1-45 || echo "installed")"
      printf "  ${C_GREEN}✔${C_RESET} %-14s %-38s ${C_DIM}(%s)${C_RESET}\n" "$bin" "$ver" "$role"
      ((ok_count+=1))
    elif [[ "$required" == "0" ]]; then
      printf "  ${C_BLUE}ℹ${C_RESET} %-14s %-38s ${C_DIM}(%s — optional in %s)${C_RESET}\n" "$bin" "OPTIONAL" "$role" "$active_profile"
    else
      printf "  ${C_YELLOW}✖${C_RESET} %-14s %-38s ${C_DIM}(%s)${C_RESET}\n" "$bin" "MISSING" "$role"
      ((warn_count+=1))
    fi
  }

  printf "${C_BOLD}1. Core Shell & CLI Tools:${C_RESET}\n"
  check_bin zsh       "Interactive shell"
  check_bin git       "Version control"
  check_bin rg        "Fast line-oriented search" "$HOME/.local/bin/rg"
  check_bin fd        "Simple, fast alternative to find" "$HOME/.local/bin/fd"
  check_bin bat       "Cat clone with syntax highlighting" "$HOME/.local/bin/bat"
  check_bin delta     "Syntax-highlighting pager for git" "$HOME/.local/bin/delta"
  check_bin eza       "Modern ls replacement with icons/git" "" "$req_pkg"
  check_bin fzf       "Fuzzy finder (fzf-tab)" "" "$req_pkg"
  check_bin zoxide    "Smart directory jumper" "$HOME/.local/bin/zoxide"
  check_bin atuin     "Magical shell history" "$HOME/.atuin/bin/atuin"
  check_bin direnv    "Per-directory environment loader" "" "$req_pkg"
  check_bin micro     "Default terminal editor"
  check_bin btop      "System resource monitor" "" "$req_pkg"
  check_bin duf       "Disk usage/free utility" "$HOME/.local/bin/duf"
  check_bin fastfetch "Neofetch-like fast system overview" "" "$req_pkg"
  check_bin starship  "Alternative cross-shell prompt"
  check_bin gh        "GitHub CLI" "" "$req_pkg"
  check_bin uv        "Fast Python package/tool manager" "$HOME/.local/bin/uv"

  printf "\n${C_BOLD}2. Shell Plugin Manager & Fonts:${C_RESET}\n"
  local zinit_dir="${XDG_DATA_HOME:-$HOME/.local/share}/zinit/zinit.git"
  if [[ -d "$zinit_dir" ]]; then
    printf "  ${C_GREEN}✔${C_RESET} %-14s %s\n" "zinit" "Installed at $zinit_dir"
    ((ok_count+=1))
  else
    printf "  ${C_YELLOW}✖${C_RESET} %-14s %s\n" "zinit" "Missing ($zinit_dir)"
    ((warn_count+=1))
  fi

  # Plugin do Powerlevel10k: se faltar, o zinit tenta baixar em CADA shell,
  # imprimindo "Downloading ..." no console -- o que faz o p10k abortar com
  # o bloco 'Console output during zsh initialization detected'.
  local p10k_dir="${XDG_DATA_HOME:-$HOME/.local/share}/zinit/plugins/romkatv---powerlevel10k"
  if [[ -d "$p10k_dir" ]]; then
    printf "  ${C_GREEN}✔${C_RESET} %-14s %s\n" "p10k plugin" "powerlevel10k installed"
    ((ok_count+=1))
  else
    printf "  ${C_YELLOW}✖${C_RESET} %-14s %s\n" "p10k plugin" "Not installed -- zinit will download it on every shell start (run './install.sh --cli')"
    ((warn_count+=1))
  fi

  # Engine do prompt REALMENTE em uso. O 'Prompt Engine' do status faz grep no
  # ~/.zshrc e erra: o arquivo pode ter sido trocado depois do shell iniciar.
  # Aqui perguntamos ao shell de verdade.
  local live_engine
  live_engine="$(zsh -i -c 'if (( $+functions[p10k] )); then print -r -- powerlevel10k; elif (( $+functions[starship__prompt] )) || [[ -n ${STARSHIP_SHELL:-} ]]; then print -r -- starship; else print -r -- unknown; fi' 2>/dev/null | tail -n1)"
  [[ -z "$live_engine" ]] && live_engine="unknown"
  local cfg_engine
  cfg_engine="$(get_active_prompt_engine)"
  if [[ "$live_engine" == "powerlevel10k" ]]; then
    printf "  ${C_GREEN}✔${C_RESET} %-14s %s\n" "Prompt Live" "powerlevel10k (active in this shell)"
    ((ok_count+=1))
  elif [[ "$live_engine" == "starship" ]]; then
    printf "  ${C_GREEN}✔${C_RESET} %-14s %s\n" "Prompt Live" "starship (active in this shell)"
    ((ok_count+=1))
  else
    printf "  ${C_YELLOW}✖${C_RESET} %-14s %s\n" "Prompt Live" "No prompt engine detected in a live shell"
    ((warn_count+=1))
  fi
  if [[ "$live_engine" != "unknown" && "$cfg_engine" != "custom" && "$live_engine" != "$cfg_engine" ]]; then
    printf "  ${C_YELLOW}ℹ${C_RESET} %-14s %s\n" "Prompt Drift" "config says '$cfg_engine' but the running shell uses '$live_engine' -- run 'source ~/.zshrc' or open a new terminal"
  fi

  if [[ "$check_fonts" == "1" ]]; then
    if command -v fc-list >/dev/null 2>&1; then
      local font_families
      font_families="$(fc-list : family 2>/dev/null || true)"
      if grep -qi "JetBrainsMono Nerd Font" <<< "$font_families"; then
        printf "  ${C_GREEN}✔${C_RESET} %-14s %s\n" "Nerd Font" "JetBrainsMono Nerd Font detected"
        ((ok_count+=1))
      else
        printf "  ${C_YELLOW}✖${C_RESET} %-14s %s\n" "Nerd Font" "JetBrainsMono Nerd Font not found (run './install.sh --fonts')"
        ((warn_count+=1))
      fi
      if grep -qi "Noto Color Emoji" <<< "$font_families"; then
        printf "  ${C_GREEN}✔${C_RESET} %-14s %s\n" "Emoji Font" "Noto Color Emoji detected"
        ((ok_count+=1))
      else
        printf "  ${C_YELLOW}✖${C_RESET} %-14s %s\n" "Emoji Font" "Noto Color Emoji not found"
        ((warn_count+=1))
      fi
    fi
  else
    printf "  ${C_BLUE}ℹ${C_RESET} %-14s %s\n" "Fonts" "Skipped for profile '${active_profile}' (client-rendered)"
  fi

  local login_shell
  login_shell="$(getent passwd "$USER" | cut -d: -f7)"
  if [[ "$login_shell" == */zsh ]]; then
    printf "  ${C_GREEN}✔${C_RESET} %-14s %s\n" "Login Shell" "$login_shell"
  else
    printf "  ${C_YELLOW}ℹ${C_RESET} %-14s %s ${C_DIM}(Konsole profile uses /bin/zsh; run 'chsh -s \$(which zsh)' for OS login shell)${C_RESET}\n" "Login Shell" "$login_shell"
  fi

  printf "\n${C_BOLD}3. Security & Secret Hygiene:${C_RESET}\n"
  if scan_secrets; then
    printf "  ${C_GREEN}✔${C_RESET} %-14s %s\n" "Secret Scan" "0 tokens or private keys found in configs/"
  else
    ((warn_count+=1))
  fi

  printf "\n${C_BOLD}Doctor Summary:${C_RESET} ${C_GREEN}%d passed${C_RESET}, ${C_YELLOW}%d warnings${C_RESET}\n\n" "$ok_count" "$warn_count"
}

# -----------------------------------------------------------------------------
# Command: bench (Zsh Startup Latency Benchmark)
# -----------------------------------------------------------------------------
cmd_bench() {
  local runs="${1:-5}"
  if ! command -v zsh >/dev/null 2>&1; then
    log_err "zsh is not installed."
    exit 1
  fi

  printf "\n${C_BOLD}${C_MAUVE}=== Zsh Interactive Startup Benchmark (%d runs) ===${C_RESET}\n" "$runs"
  local total_ms=0 min_ms=999999 max_ms=0

  for ((i=1; i<=runs; i++)); do
    local t0 t1 elapsed_ms
    t0="$(date +%s%3N)"
    zsh -i -c exit >/dev/null 2>&1
    t1="$(date +%s%3N)"
    elapsed_ms=$(( t1 - t0 ))
    total_ms=$(( total_ms + elapsed_ms ))
    (( elapsed_ms < min_ms )) && min_ms=$elapsed_ms
    (( elapsed_ms > max_ms )) && max_ms=$elapsed_ms
    printf "  Run #%d: ${C_CYAN}%d ms${C_RESET}\n" "$i" "$elapsed_ms"
  done

  local avg_ms=$(( total_ms / runs ))
  printf "\n  ${C_BOLD}Result:${C_RESET} avg=${C_GREEN}%d ms${C_RESET} · min=${C_CYAN}%d ms${C_RESET} · max=${C_YELLOW}%d ms${C_RESET}\n\n" "$avg_ms" "$min_ms" "$max_ms"
}

# -----------------------------------------------------------------------------
# Command: update (Git Pull + Apply — safe for remote hosts, zero installs)
# -----------------------------------------------------------------------------
cmd_update() {
  local check_only=0
  local dry_run=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --check|-c) check_only=1; shift ;;
      --dry-run|-n) dry_run=1; shift ;;
      --profile)
        CLI_PROFILE_OVERRIDE="${2:-}"
        validate_cli_profile_override
        shift 2
        ;;
      --profile=*)
        CLI_PROFILE_OVERRIDE="${1#*=}"
        validate_cli_profile_override
        shift
        ;;
      *)
        log_err "Unknown option for update: $1"
        exit 1
        ;;
    esac
  done

  if (( check_only == 1 )); then
    cmd_check_update
    return $?
  fi

  if [[ ! -d "$REPO_ROOT/.git" ]]; then
    log_err "Not a git repository: $REPO_ROOT"
    exit 1
  fi

  local before_head
  before_head="$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null || echo "none")"

  # Fetch + fast-forward only (aborts on divergence — safe, no merge commits)
  log_info "Pulling latest changes from origin..."
  if ! git -C "$REPO_ROOT" pull --ff-only 2>&1; then
    log_err "git pull --ff-only failed (local diverged from remote?)"
    log_err "Run 'dots status' to inspect, then resolve manually."
    exit 1
  fi

  local after_head
  after_head="$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null || echo "none")"

  if [[ "$before_head" == "$after_head" ]]; then
    log_ok "Already up to date."
  else
    local commits_pulled
    commits_pulled="$(git -C "$REPO_ROOT" log --oneline "${before_head}..${after_head}" 2>/dev/null | wc -l)"
    log_ok "Pulled ${commits_pulled} commit(s)."
    git -C "$REPO_ROOT" log --oneline "${before_head}..${after_head}" | sed "s/^/    /"
  fi

  refresh_update_cache_from_git "$(date +%s)"

  # Apply active profile configs
  printf "\n"
  if (( dry_run == 1 )); then
    cmd_apply profile --dry-run
  else
    cmd_apply profile
  fi
}

# -----------------------------------------------------------------------------
# Command: backup (List / Restore Backups)
# -----------------------------------------------------------------------------
cmd_backup() {
  local sub="${1:-list}"
  shift || true

  case "$sub" in
    list)
      printf "\n${C_BOLD}${C_MAUVE}=== Dotfiles Automatic Backups ===${C_RESET} (${C_DIM}%s${C_RESET})\n" "$BACKUP_ROOT"
      if [[ ! -d "$BACKUP_ROOT" ]] || [[ -z "$(ls -A "$BACKUP_ROOT" 2>/dev/null)" ]]; then
        printf "  ${C_DIM}No backups created yet.${C_RESET}\n\n"
        return 0
      fi
      for dir in "$BACKUP_ROOT"/*; do
        [[ -d "$dir" ]] || continue
        local id count
        id="$(basename "$dir")"
        count="$(find "$dir" -type f | wc -l)"
        printf "  • ${C_CYAN}%-18s${C_RESET} (%d file(s))\n" "$id" "$count"
      done
      printf "\n${C_DIM}Restore with: dots backup restore <timestamp>${C_RESET}\n\n"
      ;;
    restore)
      local id="${1:-}"
      if [[ -z "$id" || ! -d "$BACKUP_ROOT/$id" ]]; then
        log_err "Usage: dots backup restore <timestamp> (run 'dots backup list' to see available IDs)"
        exit 1
      fi
      while IFS= read -r -d '' file; do
        local rel="${file#"$BACKUP_ROOT/$id/"}"
        mkdir -p "$(dirname "$HOME/$rel")"
        cp -p "$file" "$HOME/$rel"
        log_ok "Restored ~/$rel"
      done < <(find "$BACKUP_ROOT/$id" -type f -print0)
      log_ok "Backup '$id' restored successfully."
      ;;
    *)
      log_err "Unknown backup subcommand: $sub (expected: list, restore)"
      exit 1
      ;;
  esac
}

# -----------------------------------------------------------------------------
# Main Dispatcher
# -----------------------------------------------------------------------------
main() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --profile)
        CLI_PROFILE_OVERRIDE="${2:-}"
        shift 2
        ;;
      --profile=*)
        CLI_PROFILE_OVERRIDE="${1#*=}"
        shift
        ;;
      *)
        break
        ;;
    esac
  done

  validate_cli_profile_override

  local cmd="${1:-status}"
  shift || true

  case "$cmd" in
    status|st)                 cmd_status "$@" ;;
    diff|df)                   cmd_diff "$@" ;;
    collect|pull|capture)      cmd_collect "$@" ;;
    apply|push|deploy)         cmd_apply "$@" ;;
    profile|pf)                cmd_profile "$@" ;;
    check-update|check-updates) cmd_check_update "$@" ;;
    theme|th)                  cmd_theme "$@" ;;
    doctor|check)              cmd_doctor "$@" ;;
    bench|benchmark)           cmd_bench "$@" ;;
    backup|bk)                 cmd_backup "$@" ;;
    update|up)                 cmd_update "$@" ;;
    -h|--help|help)            usage ;;
    *)
      log_err "Unknown command: $cmd"
      usage
      exit 1
      ;;
  esac
}

main "$@"
